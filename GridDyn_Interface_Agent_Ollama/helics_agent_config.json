{
  "name": "GridDynAgentGateway",
  "coreType": "zmq",
  "period": 1.0,
  "offset": 0.0,
  "uninterruptible": false,
  "terminate_on_error": true,
  "wait_for_current_time_update": true,
  "federate_init_string": "--broker_address=127.0.0.1 --port=23405",
  "subscriptions": [
    {
      "key": "GridDyn/bus_N07/voltage",
      "type": "double",
      "units": "pu",
      "global": true,
      "required": false,
      "tags": {
        "asset_id": "N07",
        "semantic": "bus_voltage",
        "source_kind": "simulated",
        "max_age_s": "5"
      }
    },
    {
      "key": "GridDyn/line_N14/loading",
      "type": "double",
      "units": "pu",
      "global": true,
      "required": false,
      "tags": {
        "asset_id": "N14",
        "semantic": "line_loading",
        "source_kind": "simulated",
        "max_age_s": "5"
      }
    },
    {
      "key": "GridDyn/system/frequency",
      "type": "double",
      "units": "Hz",
      "global": true,
      "required": false,
      "tags": {
        "asset_id": "system",
        "semantic": "system_frequency",
        "source_kind": "simulated",
        "max_age_s": "5"
      }
    }
  ],
  "endpoints": [
    {
      "name": "GridDynAgentGateway/events",
      "type": "json",
      "global": true,
      "info": "Incoming GridDyn event messages are normalized into the agent context packet."
    }
  ]
}
